{
	"name": "mwk-dial-countdown",
	"version": "3.3.0",
	"private": true,
	"description": "Stream Deck countdown timer for dials and keys, with presets, press-to-pause and double-tap-to-reset.",
	"type": "module",
	"scripts": {
		"build": "rollup -c",
		"watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.matewishkey.dial-countdown-v2\"",
		"test": "node --import ./test/ts-resolve.mjs --test --test-timeout=60000 \"test/*.test.ts\"",
		"typecheck": "tsc -p tsconfig.test.json",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run version:check",
		"version:check": "node tools/check-version.mjs",
		"release": "node tools/release.mjs",
		"mock": "node tools/mock-host.mjs",
		"demo": "node tools/mock-host.mjs --demo",
		"icons": "node --import ./test/ts-resolve.mjs tools/make-icons.mjs"
	},
	"devDependencies": {
		"@elgato/cli": "^1.8.0",
		"@eslint/js": "^9.39.5",
		"@rollup/plugin-commonjs": "^29.0.2",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-replace": "^6.0.3",
		"@rollup/plugin-terser": "^1.0.0",
		"@rollup/plugin-typescript": "^12.1.0",
		"@tsconfig/node24": "^24.0.5",
		"@types/node": "~24.1.0",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.11.0",
		"prettier": "^3.9.6",
		"rollup": "^4.0.2",
		"tslib": "^2.6.2",
		"typescript": "^5.2.2",
		"typescript-eslint": "^8.68.0",
		"ws": "^8.18.0"
	},
	"dependencies": {
		"@elgato/streamdeck": "^2.1.0"
	}
}
