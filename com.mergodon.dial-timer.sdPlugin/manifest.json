				"TriggerDescription": {
					"Rotate": "Adjust time",
					"Push": "Start / pause",
					"LongTouch": "Reset",
					"Touch": "Next preset"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/timer/key",
					"TitleAlignment": "middle"
				}
			]
		}
	],
	"Category": "Dial Timer",
	"CategoryIcon": "imgs/plugin/category-icon",
	"CodePath": "bin/plugin.js",
	"Description": "Countdown timers for the Stream Deck + dials. Cycle presets from the touchscreen, press the dial to start or pause, hold to reset, and turn to adjust on the fly.",
